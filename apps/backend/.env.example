# Server
NODE_ENV=development
PORT=4000
API_VERSION=v1

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/audio_ai_studio
DB_HOST=localhost
DB_PORT=5432
DB_NAME=audio_ai_studio
DB_USER=user
DB_PASSWORD=password
DB_POOL_MIN=2
DB_POOL_MAX=10

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# OAuth
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxx
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

GITHUB_CLIENT_ID=xxx
GITHUB_CLIENT_SECRET=xxx
GITHUB_CALLBACK_URL=http://localhost:4000/api/v1/auth/github/callback

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_FREE=price_xxx
STRIPE_PRICE_STARTER=price_xxx
STRIPE_PRICE_CREATOR=price_xxx
STRIPE_PRICE_PRO=price_xxx
STRIPE_PRICE_SCALE=price_xxx
STRIPE_PRICE_BUSINESS=price_xxx

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=xxx
AWS_SECRET_ACCESS_KEY=xxx
S3_BUCKET=audio-ai-studio-assets
S3_BUCKET_REGION=us-east-1

# Email (SendGrid/SES)
EMAIL_FROM=noreply@audioaistudio.com
SENDGRID_API_KEY=xxx
# OR use AWS SES
AWS_SES_REGION=us-east-1

# AI Model Endpoints
TTS_MODEL_ENDPOINT=http://tts-inference:8000
STT_MODEL_ENDPOINT=http://stt-inference:8000
VOICE_CLONE_ENDPOINT=http://voice-clone:8000
DUBBING_ENDPOINT=http://dubbing:8000

# Rate Limiting
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX=100
RATE_LIMIT_PREMIUM_MAX=1000

# Security
BCRYPT_ROUNDS=12
MFA_ISSUER=AudioAIStudio
CORS_ORIGIN=http://localhost:3000

# Webhooks
WEBHOOK_SECRET=your-webhook-secret

# Monitoring
SENTRY_DSN=
DATADOG_API_KEY=

# Feature Flags
ENABLE_MFA=true
ENABLE_VOICE_CLONING=true
ENABLE_DUBBING=true
ENABLE_STT=true
ENABLE_CONVERSATIONAL_AI=true
